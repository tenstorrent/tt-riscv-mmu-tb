          "id": "code_pages",
          "num_pages": 500,
          "pa_and": "0x000000FFFFFFF000",
          "attributes": {
            "size": ["4kb", "2mb"],
            "r": 1,
            "w": 1,
            "x": 1,
            "a": 1,
            "d": 1,
            "u": 0
          }
        },
        {
          "id": "data_pages",
          "num_pages": 500,
          "pa_and": "0x000000FFFFFFF000",
          "attributes": {
            "size": ["4kb", "2mb"],
            "r": 1,
            "w": 1,
            "x": 1,
            "a": 1,
            "d": 1,
            "u": 0
          }
        }
      ]
    }
  }
